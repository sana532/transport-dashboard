# Production / local API base (no trailing slash issues — include /api)
# Local example: https://syria-travel.app/api
# Or relative proxy: /api
VITE_API_BASE_URL=https://syria-travel.app/api

# Laravel Reverb (real-time trip tracking)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=syria-travel.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_AUTH_ENDPOINT=https://syria-travel.app/api/broadcasting/auth

# Firebase Cloud Messaging (web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
